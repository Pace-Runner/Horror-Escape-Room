    const a = Math.random() * Math.PI * 2;
    const d = Math.pow(Math.random(), 0.55) * S * 0.34;
    const x = S / 2 + Math.cos(a) * d;
    const y = S / 2 + Math.sin(a) * d;
    if (m[((y | 0) * S + (x | 0)) * 4] < 90) continue;   // only where there is water
